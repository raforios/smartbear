							"var jsonData = pm.response.json();",
							"if (jsonData && jsonData.presigned_url) {",
							"    pm.environment.set(\"presigned_url\", jsonData.presigned_url);",
							"    console.log(\"presigned_url set to: \" + jsonData.presigned_url);",
							"} else if (jsonData && jsonData.is_form_complete) {",
