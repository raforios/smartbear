{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7g8h-9i0j-k1l2m3n4o5p6",
		"name": "TRADE Service (Optimized Flow V3)",
		"description": "Colección optimizada para validación de cliente.\n\nEstructura:\n1. Auth: Login.\n2. Backoffice: Gestión completa (CRUD) de Productos y POS.\n3. Ejecución (Ruta): Flujo paso a paso de una visita (Inventario -> Venta -> Foto -> Reposición -> Foto -> Cierre).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();",
									"pm.environment.set(\"auth_token\", jsonData.access_token);",
									"console.log(\"Auth Token Updated\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"raforios@gmail.com\",\n    \"password\": \"MotoPassword\"\n}"
						},
						"url": "{{AUTH_URL}}/login"
					}
				}
			]
		},
		{
			"name": "1. Backoffice: Products (CRUD)",
			"description": "Gestión del Catálogo de Productos.",
			"item": [
				{
					"name": "1.1 Create Product",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();",
									"pm.environment.set(\"product_sku\", jsonData.sku);",
									"pm.environment.set(\"product_id\", jsonData.id);",
									"console.log(\"Product Created: \" + jsonData.sku);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Coca Cola 3L\",\n  \"description\": \"Gaseosa Retornable\",\n  \"category_1_code\": \"BEB\",\n  \"category_2_code\": \"GAS\",\n  \"company_id\": {{company_id}}\n}"
						},
						"url": "{{BASE_URL}}/products"
					}
				},
				{
					"name": "1.2 List Products",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"url": "{{BASE_URL}}/products?company_id={{company_id}}"
					}
				},
				{
					"name": "1.3 Update Product",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Coca Cola 3L (Updated)\",\n  \"description\": \"Nueva descripción\"\n}"
						},
						"url": "{{BASE_URL}}/products/{{product_id}}"
					}
				},
				{
					"name": "1.4 Delete Product",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"url": "{{BASE_URL}}/products/{{product_id}}"
					}
				},
				{
					"name": "1.5 Assign Product to POS",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": {{company_id}},\n  \"point_of_sale_id\": {{pos_id}},\n  \"product_id\": {{product_id}}\n}"
						},
						"url": "{{BASE_URL}}/products/pos-assignments"
					}
				}
			]
		},
		{
			"name": "2. Backoffice: POS (CRUD)",
			"description": "Gestión de Puntos de Venta y Surtido Inicial.",
			"item": [
				{
					"name": "2.1 Create POS (with Inventory)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();",
									"pm.environment.set(\"pos_id\", jsonData.id);",
									"console.log(\"POS Created ID: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": {{company_id}},\n  \"name\": \"Supermercado Norte\",\n  \"external_code\": \"POS-TEST-001\",\n  \"address\": \"Av. Banzer\",\n  \"latitude\": -17.7833,\n  \"longitude\": -63.1821,\n  \"initial_inventory\": [\n    {\n      \"product_sku\": \"{{product_sku}}\",\n      \"quantity\": 50,\n      \"location\": \"Almacen\",\n      \"batch_number\": \"INIT-001\",\n      \"expiration_date\": \"2025-12-31\"\n    }\n  ]\n}"
						},
						"url": "{{BASE_URL}}/pos/pos"
					}
				},
				{
					"name": "2.2 List POS",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"url": "{{BASE_URL}}/pos/pos?company_id={{company_id}}"
					}
				},
				{
					"name": "2.3 Update POS",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Supermercado Norte (Updated)\",\n  \"is_active\": true\n}"
						},
						"url": "{{BASE_URL}}/pos/pos/{{pos_id}}"
					}
				},
				{
					"name": "2.4 Delete POS",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"url": "{{BASE_URL}}/pos/pos/{{pos_id}}"
					}
				}
			]
		},
		{
			"name": "3. Trade Execution (Routine Flow)",
			"description": "Simulación secuencial de una visita.",
			"item": [
				{
					"name": "3.0 Setup: Create Promotion",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();",
									"pm.environment.set(\"promotion_id\", jsonData.id);",
									"console.log(\"Promotion ID: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": {{company_id}},\n  \"name\": \"Pack Verano\",\n  \"description\": \"Promo\",\n  \"start_date\": \"2025-01-01T00:00:00\",\n  \"end_date\": \"2025-12-31T00:00:00\",\n  \"details\": [\n    {\n      \"product_sku\": \"{{product_sku}}\"\n    }\n  ]\n}"
						},
						"url": "{{BASE_URL}}/impulses/promotions"
					}
				},
				{
					"name": "3.1 START: Impulse Inventory",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": {{company_id}},\n  \"pos_id\": {{pos_id}},\n  \"items\": [\n    {\n      \"product_sku\": \"{{product_sku}}\",\n      \"quantity\": 45\n    }\n  ]\n}"
						},
						"url": "{{BASE_URL}}/impulses/visit/{{attendance_id}}/inventory-start"
					}
				},
				{
					"name": "3.2 ACTIVITY: Register Sale (JSON)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();",
									"// Guardamos el ID para usarlo en el siguiente paso (Foto)\n",
									"pm.environment.set(\"last_entity_id\", jsonData.id);",
									"console.log(\"Sale ID saved: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": {{company_id}},\n  \"pos_id\": {{pos_id}},\n  \"details\": [\n    {\n      \"product_sku\": \"{{product_sku}}\",\n      \"quantity\": 2,\n      \"promotion_id\": {{promotion_id}}\n    }\n  ]\n}"
						},
						"url": "{{BASE_URL}}/impulses/visit/{{attendance_id}}/sale"
					}
				},
				{
					"name": "3.3 EVIDENCE: Upload Sale Photo",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "company_id", "value": "{{company_id}}", "type": "text" },
								{ "key": "entity_type", "value": "IMPULSE_SALE", "type": "text" },
								{ "key": "entity_id", "value": "{{last_entity_id}}", "type": "text" },
								{ "key": "description", "value": "Foto de venta", "type": "text" },
								{ "key": "file", "type": "file", "src": [] }
							]
						},
						"url": "{{BASE_URL}}/common/photos"
					}
				},
				{
					"name": "3.4 ACTIVITY: Replenishment Report (JSON)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();",
									"pm.environment.set(\"last_entity_id\", jsonData.id);",
									"console.log(\"Rep Report ID saved: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": {{company_id}},\n  \"comments\": \"Gondola llena.\"\n}"
						},
						"url": "{{BASE_URL}}/replenishment/visit/{{attendance_id}}/report"
					}
				},
				{
					"name": "3.5 EVIDENCE: Upload Rep. Photo",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "company_id", "value": "{{company_id}}", "type": "text" },
								{ "key": "entity_type", "value": "REPLENISHMENT_REPORT", "type": "text" },
								{ "key": "entity_id", "value": "{{last_entity_id}}", "type": "text" },
								{ "key": "description", "value": "Gondola Foto", "type": "text" },
								{ "key": "file", "type": "file", "src": [] }
							]
						},
						"url": "{{BASE_URL}}/common/photos"
					}
				},
				{
					"name": "3.6 ACTIVITY: Detailed Inventory",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": {{company_id}},\n  \"pos_id\": {{pos_id}},\n  \"items\": [\n    {\n      \"product_sku\": \"{{product_sku}}\",\n      \"batch_number\": \"LOTE-NUEVO\",\n      \"expiration_date\": \"2026-01-01\",\n      \"quantity\": 100,\n      \"location\": \"Gondola\"\n    }\n  ]\n}"
						},
						"url": "{{BASE_URL}}/replenishment/visit/{{attendance_id}}/inventory"
					}
				},
				{
					"name": "3.7 ACTIVITY: Competition Report",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();",
									"pm.environment.set(\"last_entity_id\", jsonData.id);",
									"console.log(\"Competition ID saved: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": {{company_id}},\n  \"user_id\": {{user_id}},\n  \"point_of_sale_id\": {{pos_id}},\n  \"competitor_name\": \"Competencia X\",\n  \"activity_type\": \"Precios Bajos\",\n  \"product_name\": \"Producto Z\",\n  \"details\": \"Estan agresivos con precios\"\n}"
						},
						"url": "{{BASE_URL}}/replenishment/complementary/competition"
					}
				},
				{
					"name": "3.8 EVIDENCE: Upload Comp. Photo",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "company_id", "value": "{{company_id}}", "type": "text" },
								{ "key": "entity_type", "value": "COMPETITION", "type": "text" },
								{ "key": "entity_id", "value": "{{last_entity_id}}", "type": "text" },
								{ "key": "description", "value": "Foto competencia", "type": "text" },
								{ "key": "file", "type": "file", "src": [] }
							]
						},
						"url": "{{BASE_URL}}/common/photos"
					}
				},
				{
					"name": "3.9 END: Impulse Inventory End",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": {{company_id}},\n  \"pos_id\": {{pos_id}},\n  \"items\": [\n    {\n      \"product_sku\": \"{{product_sku}}\",\n      \"quantity\": 40\n    }\n  ]\n}"
						},
						"url": "{{BASE_URL}}/impulses/visit/{{attendance_id}}/inventory-end"
					}
				}
			]
		}
	]
}