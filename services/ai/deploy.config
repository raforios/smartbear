# Variables de configuración para el despliegue del microservicio

FUNCTION_NAME=ai-handler-service
ROLE_NAME=lambda-service-ai-execution-role
ZIP_FILE=ai_handler_function.zip
API_NAME=ai-service
REGION=us-east-1
TIMEOUT=60
MEMORY_SIZE=512
PROFILE=deploy_ml
S3_ARTIFACTS_BUCKET=lambda-code-microservices
DOCKER_IMAGE_NAME=ai-lambda-builder

# --- DynamoDB ---
# El servicio usa DOS tablas: 'ai_prompts' (los roles, versionados) y
# 'ai_explanations' (el caché con TTL). build_and_deploy sólo admite una y con
# ella arma la política IAM; el acceso a las dos lo cubre
# AmazonDynamoDBFullAccess, que el deploy adjunta al rol.
#
# 'ai_prompts' tiene clave compuesta, que build_and_deploy no sabe crear: las
# dos se crean con services/ci/api/create_dynamodb_tables.sh.
DYNAMODB_TABLE_NAME=ai_explanations
DYNAMODB_PRIMARY_KEY_NAME=cache_key
DYNAMODB_PRIMARY_KEY_TYPE=S
DYNAMODB_TTL_ENABLED=true
DYNAMODB_TTL_ATTRIBUTE_NAME=expires_at
