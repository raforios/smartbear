# Variables de configuración para el despliegue del microservicio

FUNCTION_NAME=billing-handler-service
ROLE_NAME=lambda-service-billing-execution-role
ZIP_FILE=billing_handler_function.zip
API_NAME=billing-handler-service
REGION=us-east-1
TIMEOUT=120
MEMORY_SIZE=256
PROFILE=deploy_ml
S3_ARTIFACTS_BUCKET=lambda-code-microservices
DOCKER_IMAGE_NAME=billing-lambda-builder

DYNAMODB_TABLE_NAME=billing_products
DYNAMODB_PRIMARY_KEY_NAME=purchase_id
DYNAMODB_PRIMARY_KEY_TYPE=S
DYNAMODB_TTL_ENABLED=false
