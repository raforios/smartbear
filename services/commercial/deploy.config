# Deployment variables for the Commercial microservice (INGEST and ANALYTICS
# joined, 23-oct-2026).

FUNCTION_NAME=commercial-handler-service
ROLE_NAME=lambda-service-commercial-execution-role
ZIP_FILE=commercial_function.zip
API_NAME=commercial-service
REGION=us-east-1
TIMEOUT=120
# 2048 MB and 120 s, the larger of the two services it joins: loading a sales
# file into pandas needed 1024 (256 caused OOM) and the analyses ran on 2048.
MEMORY_SIZE=2048
PROFILE=deploy_ml
S3_ARTIFACTS_BUCKET=lambda-code-microservices
DOCKER_IMAGE_NAME=commercial-lambda-builder
DYNAMODB_TABLE_NAME=ingest_datasets
# Clave real de la tabla en AWS. Debe coincidir con lo declarado en
# services/ci/api/create_dynamodb_tables.sh: son dos declaraciones de
# la misma tabla y ya divergieron una vez.
DYNAMODB_PRIMARY_KEY_NAME=id
DYNAMODB_PRIMARY_KEY_TYPE=S
DYNAMODB_TTL_ENABLED=false

# CORS de ESTE API: el servicio expone PATCH (correcciones y asignaciones).
# build_and_deploy.sh lo aplica al crear el API y en cada redespliegue.
CORS_ALLOW_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
