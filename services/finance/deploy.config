# Deployment variables for the Finance microservice.

FUNCTION_NAME=finance-handler-service
ROLE_NAME=lambda-service-finance-execution-role
ZIP_FILE=finance_function.zip
API_NAME=finance-service
REGION=us-east-1
TIMEOUT=29
# The service reads and writes items. No dataframes, no models.
MEMORY_SIZE=1024
PROFILE=deploy_ml
S3_ARTIFACTS_BUCKET=lambda-code-microservices
DOCKER_IMAGE_NAME=finance-lambda-builder
# CORS de ESTE API: el servicio expone PATCH y DELETE (el catálogo del ADMIN).
# Sin esto el preflight de esos métodos falla en el navegador.
CORS_ALLOW_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
# OJO: finance_law_parameters tiene clave compuesta y el servicio usa dos
# tablas; build_and_deploy.sh sólo sabe crear una tabla de clave simple.
# Créalas con services/ci/api/create_dynamodb_tables.sh y despliega con
# --skip-table-creation.
DYNAMODB_TABLE_NAME=finance_accounts
DYNAMODB_PRIMARY_KEY_NAME=account_code
DYNAMODB_PRIMARY_KEY_TYPE=S
DYNAMODB_TTL_ENABLED=false
