# Deployment variables for the Ingest microservice.

FUNCTION_NAME=ingest-handler-service
ROLE_NAME=lambda-service-ingest-execution-role
ZIP_FILE=ingest_function.zip
API_NAME=ingest-service
REGION=us-east-1
TIMEOUT=30
# 1024 MB: ingest loads full sales CSVs (~37 MB / 120k rows) into pandas for
# normalization; 256 MB caused OOM. More memory also raises the CPU share, so a
# 120k-row file processes in a couple of seconds (well under the 30 s timeout).
MEMORY_SIZE=1024
PROFILE=deploy_ml
S3_ARTIFACTS_BUCKET=lambda-code-microservices
DOCKER_IMAGE_NAME=ingest-lambda-builder
DYNAMODB_TABLE_NAME=ingest_datasets
# Clave real de la tabla en AWS. Debe coincidir con lo declarado en
# services/ci/api/create_dynamodb_tables.sh: son dos declaraciones de
# la misma tabla y ya divergieron una vez.
DYNAMODB_PRIMARY_KEY_NAME=id
DYNAMODB_PRIMARY_KEY_TYPE=S
DYNAMODB_TTL_ENABLED=false
