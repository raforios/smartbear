# Variables de configuración para el despliegue del microservicio

FUNCTION_NAME=mining-handler-service
ROLE_NAME=lambda-service-mining-execution-role
ZIP_FILE=mining_handler_function.zip
API_NAME=mining-handler-service
REGION=us-east-1
TIMEOUT=120
# Los reportes PDF/PNG del boletín llegan a ~437 MB de pico: PIL arma la
# imagen completa en memoria y sólo los imports ya ocupan 155 MB. Con 256 MB
# el Lambda moría con Runtime.OutOfMemory. 1024 es lo que usan AUTH, FILES,
# EVENTS e INGEST.
MEMORY_SIZE=1024
PROFILE=deploy_ml
S3_ARTIFACTS_BUCKET=lambda-code-microservices
DOCKER_IMAGE_NAME=mining-lambda-builder

# --- DynamoDB ---
# El servicio usa DOS tablas: 'minerals' (catálogo) y 'mining_prices'
# (cotizaciones), ambas creadas con create_dynamodb_tables.sh. Aquí va la que
# concentra el volumen; el acceso a las dos lo cubre AmazonDynamoDBFullAccess,
# que el deploy adjunta al rol.
DYNAMODB_TABLE_NAME=mining_prices
DYNAMODB_PRIMARY_KEY_NAME=mineral_id
DYNAMODB_PRIMARY_KEY_TYPE=S
DYNAMODB_TTL_ENABLED=false
