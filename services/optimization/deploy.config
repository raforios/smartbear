# Deployment variables for the Optimization microservice.

FUNCTION_NAME=optimization-handler-service
ROLE_NAME=lambda-service-optimization-execution-role
ZIP_FILE=optimization_function.zip
API_NAME=optimization-service
REGION=us-east-1
TIMEOUT=30
MEMORY_SIZE=256
PROFILE=deploy_ml
S3_ARTIFACTS_BUCKET=lambda-code-microservices
DOCKER_IMAGE_NAME=optimization-lambda-builder
DYNAMODB_TABLE_NAME=optimization_routes
DYNAMODB_PRIMARY_KEY_NAME=route_day_key
DYNAMODB_PRIMARY_KEY_TYPE=S
DYNAMODB_TTL_ENABLED=false
