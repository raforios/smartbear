# Deployment variables for the Parameters microservice.

FUNCTION_NAME=parameters-handler-service
ROLE_NAME=lambda-service-parameters-execution-role
ZIP_FILE=parameters_function.zip
API_NAME=parameters-service
REGION=us-east-1
TIMEOUT=29
# The service reads and writes items. No dataframes, no models.
MEMORY_SIZE=1024
PROFILE=deploy_ml
S3_ARTIFACTS_BUCKET=lambda-code-microservices
DOCKER_IMAGE_NAME=parameters-lambda-builder
# CORS de ESTE API: el servicio expone PUT y DELETE (los cambios del ADMIN).
# Sin esto el preflight de esos métodos falla en el navegador.
CORS_ALLOW_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
# OJO: parameters_values tiene clave compuesta (scope + code) y
# build_and_deploy.sh sólo sabe crear claves simples. Se crea con
# services/ci/api/create_dynamodb_tables.sh y se despliega con
# --skip-table-creation.
DYNAMODB_TABLE_NAME=parameters_values
DYNAMODB_PRIMARY_KEY_NAME=scope
DYNAMODB_PRIMARY_KEY_TYPE=S
DYNAMODB_TTL_ENABLED=false
