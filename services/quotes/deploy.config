# Deployment variables for the Quotes microservice.

FUNCTION_NAME=quotes-handler-service
ROLE_NAME=lambda-service-quotes-execution-role
ZIP_FILE=quotes_function.zip
API_NAME=quotes-service
REGION=us-east-1
# The sync walks the BCB one date at a time, so a wide backfill is slow by
# nature. Kept under the API Gateway 29 s limit for the day-to-day refresh; a
# long backfill is run once from the CLI.
TIMEOUT=29
# 256 MB: the service reads a page and writes items. No dataframes, no models.
MEMORY_SIZE=256
PROFILE=deploy_ml
S3_ARTIFACTS_BUCKET=lambda-code-microservices
DOCKER_IMAGE_NAME=quotes-lambda-builder
# OJO: esta tabla tiene clave compuesta y build_and_deploy.sh solo sabe
# crear claves simples. Créala con services/ci/api/create_dynamodb_tables.sh
# y despliega con --skip-table-creation.
DYNAMODB_TABLE_NAME=exchange_rates
DYNAMODB_PRIMARY_KEY_NAME=currency
# Clave de orden real de la tabla: date (S).
DYNAMODB_PRIMARY_KEY_TYPE=S
DYNAMODB_TTL_ENABLED=false
